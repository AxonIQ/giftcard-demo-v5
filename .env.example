# Copy this file to ".env" (which is git-ignored) and fill in your own values.
# Docker Compose reads .env automatically from this directory.

# Axoniq Platform token used by Axon Server and Axoniq Insights in docker-compose.yml.
# Format: <id>:<secret>, as shown in the Axoniq Platform console for your environment.
AXONIQ_PLATFORM_AUTHENTICATION=
